
/* Name of this module. Used as the prefix on every log line, so it carries no
   version. */
#define PACKAGE_NAME "trigemit-kafka"

/* Numeric version, from the nearest git tag. 0.0.0 when the tree has no tag
   to derive one from. */
#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* Full build identifier from 'git describe': the tag, or the tag plus commit
   distance and short hash, plus "-dirty" for a modified tree. Never empty;
   falls back to "unknown" without git. See cmake/VersionString.cmake. */
#define GIT_COMMIT_ID "@GIT_COMMIT_ID@"

/* What kafka_info() reports. The build id subsumes the version when a tag is
   reachable, so this is one string rather than two. */
#define PACKAGE_STRING PACKAGE_NAME "-" GIT_COMMIT_ID

/* Whether debug_print() diagnostics are compiled in. Set by the
   TRIGEMIT_DEBUG option at configure time. */
#cmakedefine01 TRIGEMIT_DEBUG
#define DEBUG TRIGEMIT_DEBUG

#define KAFKA_MAX_SETUP_VAR_LEN 512

/* Kafka's own limit on topic name length */
#define KAFKA_MAX_TOPIC_LEN 249

/* Size of the fixed result buffer the server hands to a string UDF.
   Returning more than this requires the function to supply its own buffer. */
#define KAFKA_UDF_RESULT_LEN 255

/* Own result buffer for kafka_info(), which can exceed KAFKA_UDF_RESULT_LEN
   once a long broker list is configured. */
#define KAFKA_INFO_MAX_LEN 1024

/* Size of the buffer a UDF hands down for an error message it will report
   back to the caller, or log. librdkafka error strings fit comfortably. */
#define KAFKA_ERRBUF_LEN 512

/* Shortest interval between two delivery-failure log lines for the same topic
   reporting the same error. A broker outage can retire tens of thousands of
   queued messages, one delivery report each; without this the error log takes
   a line per message. Failures in between are counted and reported in the
   next line rather than dropped. */
#define KAFKA_ERROR_LOG_INTERVAL_S 60

/* How long teardown waits for librdkafka to deliver what is still queued
   before giving up on it. Bounded on purpose: this runs on kafka_disconnect(),
   on DROP FUNCTION and on server shutdown, none of which may hang. */
#define KAFKA_FLUSH_TIMEOUT_MS 10000
